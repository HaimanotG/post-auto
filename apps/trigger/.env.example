TRIGGER_SECRET_KEY=tr_dev_placeholder
TRIGGER_PROJECT_REF=proj_placeholder
NODE_ENV=development
# 32 raw bytes hex-encoded (64 hex chars) — generate with `openssl rand -hex 32`; must match apps/api's TOKEN_ENCRYPTION_KEY
TOKEN_ENCRYPTION_KEY=0011223344556677889900112233445566778899001122334455667788990011
# DeepSeek API key; both AI pipelines (intent-classification, reply-generation) default to DeepSeek models
DEEPSEEK_API_KEY=sk-placeholder
# Only needed if a task in packages/ai/src/model-router.ts is routed to Anthropic/OpenAI instead of DeepSeek
ANTHROPIC_API_KEY=sk-ant-placeholder
OPENAI_API_KEY=sk-placeholder
# Rendered-slide object storage. Leave RENDER_STORAGE_BUCKET unset to fall back to local disk
# (RENDER_STORAGE_DIR, default /tmp/postauto-render) for local dev only -- production needs a real
# S3-compatible bucket (AWS S3, Cloudflare R2, MinIO, ...) since Meta's Graph API fetches
# `imageUrl` over public HTTPS server-side, which a local file:// path can never satisfy.
RENDER_STORAGE_DIR=
RENDER_STORAGE_BUCKET=
RENDER_STORAGE_REGION=
# Only needed for S3-compatible providers other than real AWS S3 (e.g. R2's account-scoped endpoint)
RENDER_STORAGE_ENDPOINT=
# Only needed for providers that require path-style requests (R2, MinIO); real AWS S3 doesn't
RENDER_STORAGE_FORCE_PATH_STYLE=
RENDER_STORAGE_ACCESS_KEY_ID=
RENDER_STORAGE_SECRET_ACCESS_KEY=
# Required once RENDER_STORAGE_BUCKET is set -- the public URL prefix uploaded slides are served from
RENDER_STORAGE_PUBLIC_URL_BASE=
# Bot token from @BotFather; sends seller notifications (reconnect-needed, publish failures, AI escalations) via Telegram
TELEGRAM_BOT_TOKEN=placeholder
