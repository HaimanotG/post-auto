NODE_ENV=development
PORT=3000
TELEGRAM_BOT_TOKEN=123456:placeholder-bot-token
# Used to build the t.me/<bot>?startapp=oauth_success deep link on the OAuth "return to Telegram" screen
TELEGRAM_BOT_USERNAME=postauto_bot
JWT_SECRET=placeholder-change-me-in-production
META_APP_ID=placeholder-meta-app-id
META_APP_SECRET=placeholder-meta-app-secret
# Threads API's own App ID/Secret -- NOT the same as META_APP_ID/META_APP_SECRET above, even though
# both live under the same Meta app. Find these in the Meta App Dashboard under Threads API > Settings.
THREADS_APP_ID=placeholder-threads-app-id
THREADS_APP_SECRET=placeholder-threads-app-secret
# Arbitrary string you also configure in the Meta App Dashboard's webhook subscription settings
META_WEBHOOK_VERIFY_TOKEN=placeholder-webhook-verify-token
# 32 raw bytes hex-encoded (64 hex chars) — generate with `openssl rand -hex 32`
TOKEN_ENCRYPTION_KEY=0011223344556677889900112233445566778899001122334455667788990011
# This API's own public HTTPS base URL (Meta redirects the OAuth callback here)
API_BASE_URL=https://api.postauto.example
# Comma-separated list of origins allowed to call this API cross-origin (the mini app frontend). Defaults to http://localhost:5173 if unset.
MINIAPP_ORIGIN=http://localhost:5173,https://postauto.vercel.app
# Phone-upload photo storage (POST /uploads). Leave UPLOAD_STORAGE_BUCKET unset to fall back to local disk
# (UPLOAD_STORAGE_DIR, default /tmp/postauto-uploads) for local dev only -- production needs a real
# S3-compatible bucket (AWS S3, Cloudflare R2, MinIO, ...) since Meta's Graph API fetches the resulting
# image URL over public HTTPS server-side, which a local file:// path can never satisfy.
UPLOAD_STORAGE_DIR=
UPLOAD_STORAGE_BUCKET=
UPLOAD_STORAGE_REGION=
# Only needed for S3-compatible providers other than real AWS S3 (e.g. R2's account-scoped endpoint)
UPLOAD_STORAGE_ENDPOINT=
# Only needed for providers that require path-style requests (R2, MinIO); real AWS S3 doesn't
UPLOAD_STORAGE_FORCE_PATH_STYLE=
UPLOAD_STORAGE_ACCESS_KEY_ID=
UPLOAD_STORAGE_SECRET_ACCESS_KEY=
# Required once UPLOAD_STORAGE_BUCKET is set -- the public URL prefix uploaded photos are served from
UPLOAD_STORAGE_PUBLIC_URL_BASE=
